# LLM provider: groq | gemini | openai
LLM_PROVIDER=groq
LLM_API_KEY=your-api-key-here
# Optional. Defaults per provider (groq: openai/gpt-oss-120b)
LLM_MODEL=openai/gpt-oss-120b

# Root password for the MySQL container (docker-compose reads it from this file)
MYSQL_ROOT_PASSWORD=change-me

# Only used when running Python outside Docker (docker-compose overrides it).
# Port 3307 is the MySQL container published on your machine.
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3307/GymManagementDB

# What "today" means for relative dates ("last month"). The sample data is from 2024.
REFERENCE_DATE=2024-05-15

# Seconds to wait between evaluation questions (helps with free-tier rate limits)
EVAL_DELAY=4
